{
  "name": "mcp-reader",
  "version": "0.2.0",
  "description": "MCP server for @vakra-dev/reader (scrape/crawl websites) with token-saving artifact truncation.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-reader": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-jardim/mcp-reader.git"
  },
  "bugs": {
    "url": "https://github.com/marco-jardim/mcp-reader/issues"
  },
  "homepage": "https://github.com/marco-jardim/mcp-reader#readme",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "claude",
    "opencode",
    "reader",
    "web-scraping",
    "crawler"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier -w .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "nanoid": "5.1.6",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "@vakra-dev/reader": "0.1.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "25.2.1",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.3.0",
    "prettier": "3.8.1",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
